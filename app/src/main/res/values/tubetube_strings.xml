    <string name="tunnel_vpn_permission_title">Allow VPN</string>
    <string name="tunnel_vpn_permission_summary">Android asks once for permission to create the app-only tunnel</string>
    <string name="tunnel_vpn_permission_denied">Without this permission the WireGuard tunnel cannot start</string>
    <string name="tunnel_info">In Tor and VPN modes TubeTube never connects directly: if the tunnel drops, requests fail instead of leaving without protection. In Direct mode there is no tunnel: still no ads and no Google account, but YouTube sees your IP address.</string>
