    <string name="tunnel_settings_title">Privacy tunnel</string>
    <string name="tunnel_settings_summary">Hide your IP address: Tor or WireGuard VPN</string>
    <string name="tunnel_mode_title">Tunnel</string>
    <string-array name="tunnel_mode_entries">
        <item>Tor (maximum anonymity, slower)</item>
        <item>WireGuard VPN (fast)</item>
        <item>Direct, no tunnel (fastest, Google sees your IP)</item>
