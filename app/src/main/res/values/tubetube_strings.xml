    <string name="sponsorblock_enabled_title">Skip promotional segments</string>
    <string name="sponsorblock_enabled_summary">Uses SponsorBlock, a community database of segments. Sends only part of a hash of the video ID (through the privacy tunnel in Tor and VPN modes)</string>
    <string name="sponsorblock_categories_title">What to skip</string>
    <string-array name="sponsorblock_categories_entries">
        <item>Sponsor (\"this video is sponsored by…\")</item>
        <item>Self-promotion (own products, courses, merch)</item>
        <item>Interaction reminders (subscribe, like, bell)</item>
        <item>Intro</item>
        <item>Outro / end cards</item>
        <item>Preview / recap</item>
        <item>Filler / tangents</item>
        <item>Non-music part of music videos</item>
    </string-array>
